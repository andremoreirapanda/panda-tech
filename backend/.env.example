# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O backend carrega ".env" automaticamente (python-dotenv) — NUNCA
# commite o ".env" de verdade no git (o .gitignore já ignora *.env).

# ------------------------- Segurança (obrigatório em produção) -------------------------
# Chave usada para assinar os tokens JWT de login. Gere uma forte com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ENCANTO_SECRET=

# Chave usada para cifrar credenciais de integrações salvas no banco
# (refresh token do Google, access token do Mercado Pago, token do WhatsApp).
# Pode ser qualquer string longa e aleatória — use o mesmo comando acima.
ENCANTO_CRYPTO_KEY=

# Domínio autorizado a chamar a API (troque '*' por isso em produção), ex:
#   ALLOWED_ORIGIN=https://app.suaclinica.com.br
ALLOWED_ORIGIN=*

# URL pública completa onde o app está publicado (sem barra no final).
# Usada só para montar links ABSOLUTOS em canais que não têm o contexto do
# navegador (hoje: o convite de responsável mandado por WhatsApp — ver
# whatsapp_service.py::enviar_convite_responsavel). Sem esta variável, o
# link de convite simplesmente não é enviado automaticamente por WhatsApp
# (continua funcionando manualmente, copiando o link na tela).
#   URL_APP=https://SEU-DOMINIO
URL_APP=

FLASK_DEBUG=0

# Quantos proxies confiáveis ficam na frente do app e acrescentam o IP do
# cliente no fim do X-Forwarded-For (usado pelo limite de tentativas de
# login, ver rate_limit.py). Deixe 0 no cPanel/LiteSpeed atual — o IP real
# já chega direto. Só mude se colocar um CDN/proxy na frente, e confira
# antes quantos IPs ele acrescenta. Um valor errado deixa o limite contornável.
ENCANTO_PROXIES_CONFIAVEIS=0

# ------------------------- Google Agenda (OAuth2) -------------------------
# Crie em https://console.cloud.google.com/apis/credentials
#   1. Novo projeto > "APIs e serviços" > "Tela de consentimento OAuth"
#      (tipo Externo, adicione seu e-mail como usuário de teste enquanto
#      o app não estiver publicado/verificado)
#   2. Ative a "Google Calendar API" em "APIs e serviços" > "Biblioteca"
#   3. "Credenciais" > "Criar credenciais" > "ID do cliente OAuth" >
#      tipo "Aplicativo da Web"
#   4. Em "URIs de redirecionamento autorizados", adicione exatamente:
#        https://SEU-DOMINIO/api/integracoes/google_calendar/callback
#      (em desenvolvimento local: http://localhost:5000/api/integracoes/google_calendar/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/integracoes/google_calendar/callback

# ------------------------- Mercado Pago (PIX / cartão) -------------------------
# Cada clínica configura o PRÓPRIO Access Token direto na tela "Central de
# Integrações" do app (painel dela: mercadopago.com.br/developers/panel) —
# não precisa de variável de ambiente aqui para isso.
#
# Só esta variável é opcional e fica no servidor (não por clínica): a chave
# secreta do webhook, para validar que a notificação é mesmo do Mercado
# Pago. Gerada em: painel > Suas integrações > sua aplicação > Webhooks.
MP_WEBHOOK_SECRET=
# URL pública que o Mercado Pago vai chamar quando o status de um
# pagamento mudar — obrigatória para a confirmação automática funcionar:
MP_NOTIFICATION_URL=https://SEU-DOMINIO/api/integracoes/pagamento/webhook
# E-mail de reserva no campo `payer.email` das cobranças da plataforma,
# usado só quando a clínica não tem e-mail de contato nem gestor com
# e-mail (opcional; padrão: financeiro@pandacriacao.com.br):
EMAIL_COBRANCA_PADRAO=

# ------------------------- WhatsApp -------------------------
# Cada clínica também configura o PRÓPRIO token + phone_number_id direto na
# tela "Central de Integrações" (painel Meta for Developers > seu app >
# WhatsApp > Introdução). Nada para configurar aqui no servidor.
